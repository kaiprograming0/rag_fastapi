
# ==============================
# Python関連
# ==============================
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# ==============================
# 仮想環境
# PCごとに異なるためGitで管理しない
# ==============================
.venv/
venv/
env/

# ==============================
# 環境変数・秘密情報
# APIキーやパスワードをGitHubに公開しない
# ==============================
.env
.env.*
!.env.example

# ==============================
# AWS認証情報
# ローカルのAWS認証情報をGitで管理しない
# ==============================
.aws/

# ==============================
# テスト・コード品質チェックの生成物
# テストやLintの実行時に生成されるため管理しない
# ==============================
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ==============================
# Jupyter Notebook
# Notebookが自動生成するチェックポイントを除外
# ==============================
.ipynb_checkpoints/

# ==============================
# エディタ・OS関連
# 個人の開発環境に依存するファイルを除外
# ==============================
.vscode/
.idea/
.DS_Store

# ==============================
# ログ・一時ファイル
# 開発中に生成される不要なファイルを除外
# ==============================
*.log
*.tmp

# ==============================
# ローカルデータベース
# 開発用DBや個人データを誤って共有しない
# ==============================
*.db
*.sqlite3

# ==============================
# 生成物・一時保存フォルダ
# 必要に応じてGit管理対象にするか見直す
# ==============================
/outputs/
/tmp/
/temp/
  